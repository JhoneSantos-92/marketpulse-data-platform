# Copie para .env e preencha. O .env nunca vai para o Git.

# Binance: somente endpoints PÚBLICOS de market data (ADR-0011). Nenhuma chave de conta.
BINANCE_WS_URL=wss://data-stream.binance.vision
BINANCE_REST_URL=https://data-api.binance.vision
SYMBOLS=btcusdt,ethusdt,solusdt

# Banco Central: série SGS 1, dólar venda (ADR-0012)
BCB_SGS_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs.1/dados

# Alertas no WhatsApp (ADR-0009)
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_TO=

# Mensageria (ADR-0002): porta externa do Redpanda, para código rodando fora do Docker
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Object storage S3 (ADR-0003). Crie suas próprias chaves; não reutilize senhas.
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
STORAGE_URI=s3://marketpulse-lake
